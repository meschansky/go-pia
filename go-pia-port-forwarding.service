[Unit]
Description=PIA VPN Port Forwarding Service
After=network.target openvpn-client@pia.service
Wants=openvpn-client@pia.service
# BindsTo=openvpn-client@pia.service # Will stop the service if the VPN connection is lost

[Service]
Type=simple
# Required configuration
# The credentials file is loaded into the service's private credential
# directory (systemd >= 247) so it can stay owned/readable only by root even
# though the service runs as `nobody`; %d expands to $CREDENTIALS_DIRECTORY.
LoadCredential=pia.txt:/etc/openvpn/client/pia.txt
Environment="PIA_CA_CERT=/usr/local/etc/pia/ca.rsa.4096.crt"

# Optional configuration
#Environment="PIA_VPN_RETRY_INTERVAL=60s" # How often to re-check the active VPN connection and re-detect its gateway
#Environment="PIA_DEBUG=true"
#Environment="PIA_REFRESH_INTERVAL=15m"

# Port change automation
#Environment="PIA_ON_PORT_CHANGE=/path/to/your/script.sh"
#Environment="PIA_SCRIPT_TIMEOUT=30s"
#Environment="PIA_SYNC_SCRIPT=true"

ExecStart=/usr/bin/env PIA_CREDENTIALS=%d/pia.txt /usr/local/bin/go-pia-port-forwarding /run/pia/port.txt
Restart=on-failure
RestartSec=30

# RuntimeDirectory creates /run/pia owned by the service user, so the output
# file can be written even when running as an unprivileged user.
RuntimeDirectory=pia
RuntimeDirectoryMode=0755

# Security hardening. It can break scripts that use PIA_ON_PORT_CHANGE as it will be run with
# a different user that may not have the same permissions to access the output file
User=nobody
Group=nogroup
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
